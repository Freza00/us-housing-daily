# 复制本文件为 .env 并填入真实值
#   cp .env.example .env
#
# .env 文件已在 .gitignore — 绝不会被 git push 上传
# 生产环境（GitHub Actions）从 Repository Secrets 读，不需要 .env

# OpenAI-compatible LLM API
# 任何 OpenAI 兼容协议都行：OpenAI / Anthropic（via proxy）/ Together / Fireworks / Groq / 自部署 vLLM
LLM_API_KEY=sk-your-key-here
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# SEC EDGAR 公平使用政策要求 fetcher User-Agent 携带真实联系方式
# 不填会用 contact@example.com 占位（SEC 仍会响应但你应替换为自己的邮箱）
SEC_CONTACT_EMAIL=your-email@example.com
