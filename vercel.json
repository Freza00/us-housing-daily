{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public/data && cp -r data/* public/data/ 2>/dev/null || true",
  "outputDirectory": "public",
  "framework": null,
  "crons": [
    { "path": "/api/trigger-daily", "schedule": "57 0 * * *" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/(style.css|app.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
